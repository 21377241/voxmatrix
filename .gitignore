# Smoke suite run artifacts (keep registry/, *.yaml, run_*.sh, helper *.py)
smoke_*/results/
smoke_*/results_*/
smoke_*/output/
smoke_*/summary.json
smoke_*/summary_*.json
smoke_*/chrf_summary.json
# Per-dataset working dirs under smoke suites (wavs/preds live here)
smoke_*/*/
!smoke_*/registry/

# Model weights and large generated media are downloaded separately.
*.bin
*.ckpt
*.onnx
*.pt
*.pth
*.safetensors
*.t7
*.mp4
*.pdf

# Evaluation audio is generated or prepared outside Git. Keep only the small
# fixtures that are intentionally part of the source tree.
*.wav
!mesh_eval/data/default.wav
!audio_evals/lib/CosyVoice/asset/zero_shot_prompt.wav

