{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vocal_bench/manifest.schema.json",
  "title": "VocalBench Manifest Sample",
  "type": "object",
  "required": [
    "sample_id",
    "dataset",
    "task",
    "capability",
    "scenario",
    "condition",
    "input",
    "reference",
    "metrics",
    "use_bucket",
    "split"
  ],
  "additionalProperties": false,
  "properties": {
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "enum": [
        "speech_understanding",
        "speaker",
        "agent",
        "speech_output",
        "runtime"
      ]
    },
    "capability": {
      "type": "string"
    },
    "scenario": {
      "type": "string",
      "enum": ["phone", "home", "vehicle", "meeting", "outdoor"]
    },
    "condition": {
      "type": "object",
      "properties": {
        "acoustic": { "type": "string" },
        "spatial": { "type": "string" },
        "speaker": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "count": { "type": "integer", "minimum": 1 },
                "authorization": { "type": "string" },
                "dialect": { "type": "string" },
                "age_group": { "type": "string" }
              }
            }
          ]
        },
        "device": { "type": "string" },
        "interaction": { "type": "string" }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["audio_path"],
      "properties": {
        "audio_path": { "type": "string" },
        "context": { "type": "object" }
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object"
    },
    "metrics": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "use_bucket": {
      "type": "string",
      "enum": [
        "formal_subscores",
        "diagnostic_evidence",
        "stress_test",
        "coverage_debt"
      ]
    },
    "split": {
      "type": "string",
      "enum": ["train", "dev", "test", "heldout"]
    },
    "label_meta": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "native",
              "rule",
              "acoustic_model",
              "llm_draft",
              "knowledge_verified",
              "knowledge_revise",
              "knowledge_flagged",
              "human"
            ]
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "annotator": { "type": "string" },
        "reviewed": { "type": "boolean" },
        "knowledge_verify_done": { "type": "boolean" },
        "knowledge_verified": { "type": "boolean" },
        "knowledge_gate": {
          "type": "string",
          "enum": ["pass", "pass_with_revise", "needs_review", "blocked"]
        },
        "knowledge_verify_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "needs_human_review": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
